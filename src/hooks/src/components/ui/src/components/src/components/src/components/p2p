'use client';
import React, { useState } from 'react';
import { P2PTrade, TradeStatus } from '@/types/p2p';
import { fmtCrypto, fmtAr, fmtCountdown, PAYMENT_COLORS } from '@/lib/format';
import { useCountdown, useTradeActions } from '@/hooks/useP2P';
import { Button, StatusBadge, Alert, Modal, Input } from '@/components/ui';

interface Props {
      trade:         P2PTrade;
        currentUserId: string;
          refetch:       () => void;
}

export const TradeSteps: React.FC<Props> = ({ trade, currentUserId, refetch }) => {
      const [showDispute, setShowDispute] = useState(false);
        const [disputeReason, setDisputeReason] = useState('');

          const isBuyer  = currentUserId === trade.buyer_id;
            const isSeller = currentUserId === trade.seller_id;
              const seconds  = useCountdown(trade.status === 'PENDING' || trade.status === 'PAID' ? trade.expires_at : null);
                const { busy, error, markPaid, releaseEscrow, cancelTrade, openDispute } = useTradeActions(trade.id, refetch);

                  const currency = trade.offer?.from_currency ?? 'CRYPTO';
                    const isExpired = seconds === 0 && (trade.status === 'PENDING' || trade.status === 'PAID');

                      return (
                            <div className="flex flex-col gap-5">
                                  {/* ── Status header ── */}
                                        <div className="bg-white/5 border border-white/10 rounded-2xl p-5">
                                                <div className="flex items-center justify-between mb-3">
                                                          <div>
                                                                      <h2 className="text-lg font-bold text-white">Trade #{trade.id.slice(0, 8).toUpperCase()}</h2>
                                                                                  <p className="text-xs text-gray-400 mt-0.5">
                                                                                                Créé le {new Date(trade.created_at).toLocaleString('fr-FR')}
                                                                                                            </p>
                                                                                                                      </div>
                                                                                                                                <StatusBadge status={trade.status} />
                                                                                                                                        </div>

                                                                                                                                                {/* Trade summary */}
                                                                                                                                                        <div className="grid grid-cols-2 gap-3 text-sm">
                                                                                                                                                                  <div className="bg-white/5 rounded-xl p-3">
                                                                                                                                                                              <p className="text-xs text-gray-400 mb-1">Vous {isBuyer ? 'achetez' : 'vendez'}</p>
                                                                                                                                                                                          <p className="font-bold text-yellow-400 text-lg">{fmtCrypto(trade.amount_crypto, currency)}</p>
                                                                                                                                                                                                    </div>
                                                                                                                                                                                                              <div className="bg-white/5 rounded-xl p-3">
                                                                                                                                                                                                                          <p className="text-xs text-gray-400 mb-1">Vous {isBuyer ? 'payez' : 'recevez'}</p>
                                                                                                                                                                                                                                      <p className="font-bold text-white text-lg">{fmtAr(trade.amount_fiat)}</p>
                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                          <div className="bg-white/5 rounded-xl p-3">
                                                                                                                                                                                                                                                                      <p className="text-xs text-gray-400 mb-1">Paiement via</p>
                                                                                                                                                                                                                                                                                  <p className="font-semibold"
                                                                                                                                                                                                                                                                                                style={{ color: PAYMENT_COLORS[trade.selected_payment_method] ?? '#fff' }}>
                                                                                                                                                                                                                                                                                                              {trade.selected_payment_method}
                                                                                                                                                                                                                                                                                                                          </p>
                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                              <div className="bg-white/5 rounded-xl p-3">
                                                                                                                                                                                                                                                                                                                                                          <p className="text-xs text-gray-400 mb-1">Taux</p>
                                                                                                                                                                                                                                                                                                                                                                      <p className="font-semibold text-white">{fmtAr(trade.offer?.rate ?? 0)} / {currency}</p>
                                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                                                                                    {/* ── Countdown ── */}
                                                                                                                                                                                                                                                                                                                                                                                                          {(trade.status === 'PENDING' || trade.status === 'PAID') && (
                                                                                                                                                                                                                                                                                                                                                                                                                    <div className={`rounded-2xl border p-5 text-center ${isExpired ? 'bg-red-500/10 border-red-500/30' : 'bg-white/5 border-white/10'}`}>
                                                                                                                                                                                                                                                                                                                                                                                                                              <p className={`text-5xl font-mono font-bold ${isExpired ? 'text-red-400' : seconds < 300 ? 'text-orange-400' : 'text-yellow-400'}`}>
                                                                                                                                                                                                                                                                                                                                                                                                                                          {isExpired ? 'EXPIRÉ' : fmtCountdown(seconds)}
                                                                                                                                                                                                                                                                                                                                                                                                                                                    </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                              <p className="text-xs text-gray-400 mt-2">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {trade.status === 'PENDING'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ? "Temps restant pour effectuer le paiement"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      : "En attente de validation par le vendeur"}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                          )}

                                                                                                                                                                                                                                                                                                                                                                                                                {/* ── Payment details (visible to buyer when PENDING) ── */}
                                                                                                                                                                                                                                                                                                                                                                                                                      {isBuyer && trade.status === 'PENDING' && trade.offer?.payment_details && (
                                                                                                                                                                                                                                                                                                                                                                                                                                <div className="bg-blue-500/10 border border-blue-500/30 rounded-2xl p-5">
                                                                                                                                                                                                                                                                                                                                                                                                                                          <h3 className="text-sm font-bold text-blue-400 mb-3">💳 Coordonnées de paiement du vendeur</h3>
                                                                                                                                                                                                                                                                                                                                                                                                                                                    <pre className="text-white text-sm whitespace-pre-wrap font-sans leading-relaxed">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                {trade.offer.payment_details}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </pre>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <p className="text-xs text-gray-400 mt-3">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Envoyez exactement <strong className="text-white">{fmtAr(trade.amount_fiat)}</strong> via <strong className="text-white">{trade.selected_payment_method}</strong>, puis cliquez "J'ai payé".
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                                                                                                      )}

                                                                                                                                                                                                                                                                                                                                                                                                                            {/* ── Step flow visual ── */}
                                                                                                                                                                                                                                                                                                                                                                                                                                  <StepFlow status={trade.status} />

                                                                                                                                                                                                                                                                                                                                                                                                                                        {/* ── Action buttons — role-based ── */}
                                                                                                                                                                                                                                                                                                                                                                                                                                              {error && <Alert type="error">{error}</Alert>}

                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div className="flex flex-col gap-3">
                                                                                                                                                                                                                                                                                                                                                                                                                                                            {/* BUYER: mark as paid */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {isBuyer && trade.status === 'PENDING' && !isExpired && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Button variant="success" loading={busy} onClick={markPaid} size="lg" className="w-full">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ✅ J'ai effectué le paiement
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {/* SELLER: release escrow */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {isSeller && trade.status === 'PAID' && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <Alert type="warning">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            L'acheteur a déclaré avoir payé. Vérifiez votre compte {trade.selected_payment_method} avant de libérer.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </Alert>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <Button variant="primary" loading={busy} onClick={releaseEscrow} size="lg" className="w-full">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  🔓 Libérer les crypto ({fmtCrypto(trade.amount_crypto, currency)})
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {/* Cancel */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {(trade.status === 'PENDING' || trade.status === 'PAID') && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div className="flex gap-3">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              {trade.status === 'PENDING' && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <Button variant="danger" loading={busy} onClick={cancelTrade} className="flex-1">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ✕ Annuler
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          {/* Dispute */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {(isBuyer || isSeller) && trade.status === 'PAID' && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Button variant="warning" onClick={() => setShowDispute(true)} className="flex-1">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ⚠️ Ouvrir un litige
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {/* Completed */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {trade.status === 'COMPLETED' && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Alert type="success">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ✅ Trade complété ! {fmtCrypto(trade.amount_crypto, currency)} ont été transférés à l'acheteur.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </Alert>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {/* Cancelled */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    {(trade.status === 'CANCELLED' || trade.status === 'DISPUTE') && (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Alert type={trade.status === 'DISPUTE' ? 'warning' : 'error'}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              {trade.status === 'CANCELLED'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ? '❌ Trade annulé. Les fonds ont été restitués au vendeur.'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          : `⚠️ Litige ouvert : "${trade.dispute_reason}" — L'admin TakaloCash examinera sous 24h.`}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </Alert>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                {/* ── Dispute modal ── */}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Modal open={showDispute} onClose={() => setShowDispute(false)} title="⚠️ Ouvrir un litige">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <div className="flex flex-col gap-4">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <Alert type="warning">Un admin TakaloCash examinera votre litige sous 24h.</Alert>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <Input label="Raison du litige" value={disputeReason}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              onChange={e => setDisputeReason(e.target.value)}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          placeholder="ex: Paiement envoyé mais crypto non libérée..." />
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div className="flex gap-3">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <Button variant="ghost" onClick={() => setShowDispute(false)} className="flex-1">Annuler</Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <Button variant="warning" loading={busy} className="flex-1"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          onClick={async () => { await openDispute(disputeReason); setShowDispute(false); }}>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Soumettre le litige
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </Button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </Modal>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>
                      );
};

// ── Step Flow Visual ─────────────────────────────────────────────────────────
const STEPS: { status: TradeStatus; label: string; icon: string }[] = [
      { status: 'PENDING',   label: 'Trade ouvert',       icon: '🔒' },
        { status: 'PAID',      label: 'Paiement déclaré',   icon: '💳' },
          { status: 'COMPLETED', label: 'Crypto libérée',     icon: '✅' },
];

const STEP_ORDER: TradeStatus[] = ['PENDING', 'PAID', 'COMPLETED'];

const StepFlow: React.FC<{ status: TradeStatus }> = ({ status }) => {
      const currentIdx = STEP_ORDER.indexOf(status);
        if (status === 'CANCELLED' || status === 'DISPUTE') return null;
          return (
                <div className="flex items-center gap-0">
                      {STEPS.map((step, i) => {
                                const done    = i < currentIdx;
                                        const active  = i === currentIdx;
                                                const pending = i > currentIdx;
                                                        return (
                                                                      <React.Fragment key={step.status}>
                                                                                  <div className={`flex flex-col items-center gap-1.5 flex-1 ${pending ? 'opacity-30' : ''}`}>
                                                                                                <div className={`w-9 h-9 rounded-full flex items-center justify-center text-base
                                                                                                                ${done ? 'bg-green-500' : active ? 'bg-yellow-400' : 'bg-white/10'}`}>
                                                                                                                                {step.icon}
                                                                                                                                              </div>
                                                                                                                                                            <p className={`text-xs text-center font-medium ${active ? 'text-yellow-400' : done ? 'text-green-400' : 'text-gray-500'}`}>
                                                                                                                                                                            {step.label}
                                                                                                                                                                                          </p>
                                                                                                                                                                                                      </div>
                                                                                                                                                                                                                  {i < STEPS.length - 1 && (
                                                                                                                                                                                                                                  <div className={`h-0.5 flex-1 -mt-5 ${done ? 'bg-green-500' : 'bg-white/10'}`} />
                                                                                                                                                                                                                  )}
                                                                                                                                                                                                                            </React.Fragment>
                                                        );
                      })}
                          </div>
          );
};
                                                                                                                                                                                                                  )}
                                                        )
                      })}
          )
}
]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    )}
                                                                                                                                                                                                                                                                                                                                                                                                                      )}
                                                                                                                                                                                                                                                                                                                                                                                                          )}
                      )
}
}