'use client';
import React, { useState, useRef } from 'react';
import { supabase } from '@/lib/supabase';
import { useChat } from '@/hooks/useP2P';
import { ChatMessage } from '@/types/p2p';
import { Spinner, Alert } from '@/components/ui';

interface Props { tradeId: string; currentUserId: string; }

export const ChatBox: React.FC<Props> = ({ tradeId, currentUserId }) => {
      const { messages, sending, sendMessage, bottomRef } = useChat(tradeId);
        const [text, setText]     = useState('');
          const [uploading, setUploading] = useState(false);
            const [uploadErr, setUploadErr] = useState<string | null>(null);
              const fileRef = useRef<HTMLInputElement>(null);

                const handleSend = async () => {
                        if (!text.trim()) return;
                            await sendMessage(text);
                                setText('');
                };

                  const handleKeyDown = (e: React.KeyboardEvent) => {
                        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }
                  };

                    const handleFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
                            const file = e.target.files?.[0];
                                if (!file) return;
                                    if (file.size > 5 * 1024 * 1024) { setUploadErr('Fichier trop grand (max 5 MB)'); return; }
                                        setUploadErr(null); setUploading(true);
                                            const path = `p2p/${tradeId}/${Date.now()}_${file.name}`;
                                                const { error } = await supabase.storage.from('trade-attachments').upload(path, file);
                                                    if (error) { setUploadErr(error.message); setUploading(false); return; }
                                                        const { data: { publicUrl } } = supabase.storage.from('trade-attachments').getPublicUrl(path);
                                                            await sendMessage(`📎 Preuve de paiement`, publicUrl);
                                                                setUploading(false);
                                                                    if (fileRef.current) fileRef.current.value = '';
                    };

                      return (
                            <div className="flex flex-col h-full bg-[#111827] rounded-2xl border border-white/10 overflow-hidden">
                                  {/* Header */}
                                        <div className="flex items-center gap-2 px-4 py-3 border-b border-white/10 bg-white/5">
                                                <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse" />
                                                        <span className="text-sm font-semibold text-white">Chat temps réel</span>
                                                                <span className="text-xs text-gray-500 ml-auto">{messages.length} messages</span>
                                                                      </div>

                                                                            {/* Messages feed */}
                                                                                  <div className="flex-1 overflow-y-auto p-4 flex flex-col gap-3 min-h-0">
                                                                                          {messages.length === 0 && (
                                                                                                      <div className="text-center text-gray-600 text-sm py-8">
                                                                                                                  💬 Aucun message — commencez la conversation
                                                                                                                            </div>
                                                                                          )}
                                                                                                  {messages.map(msg => <MessageBubble key={msg.id} msg={msg} isMine={msg.sender_id === currentUserId} />)}
                                                                                                          <div ref={bottomRef} />
                                                                                                                </div>

                                                                                                                      {/* Upload error */}
                                                                                                                            {uploadErr && <div className="px-4 pb-2"><Alert type="error">{uploadErr}</Alert></div>}

                                                                                                                                  {/* Input area */}
                                                                                                                                        <div className="border-t border-white/10 p-3 flex items-end gap-2">
                                                                                                                                                {/* File upload */}
                                                                                                                                                        <input ref={fileRef} type="file" accept="image/*,application/pdf" className="hidden" onChange={handleFile} />
                                                                                                                                                                <button onClick={() => fileRef.current?.click()} disabled={uploading}
                                                                                                                                                                          className="flex-shrink-0 w-9 h-9 rounded-xl bg-white/10 hover:bg-white/20 text-gray-400 hover:text-white flex items-center justify-center transition-colors disabled:opacity-50"
                                                                                                                                                                                    title="Joindre une preuve de paiement">
                                                                                                                                                                                              {uploading ? <span className="w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin" /> : '📎'}
                                                                                                                                                                                                      </button>

                                                                                                                                                                                                              {/* Text input */}
                                                                                                                                                                                                                      <textarea value={text} onChange={e => setText(e.target.value)} onKeyDown={handleKeyDown}
                                                                                                                                                                                                                                placeholder="Message... (Entrée pour envoyer)"
                                                                                                                                                                                                                                          rows={1}
                                                                                                                                                                                                                                                    className="flex-1 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-white text-sm placeholder-gray-600 outline-none focus:border-yellow-400 resize-none transition-colors" />

                                                                                                                                                                                                                                                            {/* Send button */}
                                                                                                                                                                                                                                                                    <button onClick={handleSend} disabled={sending || !text.trim()}
                                                                                                                                                                                                                                                                              className="flex-shrink-0 w-9 h-9 rounded-xl bg-yellow-400 hover:bg-yellow-300 text-black font-bold flex items-center justify-center transition-colors disabled:opacity-50">
                                                                                                                                                                                                                                                                                        {sending ? <span className="w-4 h-4 border-2 border-black border-t-transparent rounded-full animate-spin" /> : '↑'}
                                                                                                                                                                                                                                                                                                </button>
                                                                                                                                                                                                                                                                                                      </div>
                                                                                                                                                                                                                                                                                                          </div>
                      );
};

// ── MessageBubble ────────────────────────────────────────────────────────────
const MessageBubble: React.FC<{ msg: ChatMessage; isMine: boolean }> = ({ msg, isMine }) => {
      const time = new Date(msg.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

        // System message
          if (msg.is_system) {
                return (
                          <div className="flex justify-center">
                                  <div className="bg-yellow-400/10 border border-yellow-400/20 text-yellow-300 text-xs rounded-xl px-4 py-2 max-w-xs text-center">
                                            {msg.message}
                                                    </div>
                                                          </div>
                );
          }

            return (
                    <div className={`flex ${isMine ? 'justify-end' : 'justify-start'} gap-2`}>
                          {/* Avatar (other party) */}
                                {!isMine && (
                                            <div className="w-7 h-7 rounded-full bg-white/10 flex-shrink-0 flex items-center justify-center text-xs text-gray-400 mt-auto">
                                                      {msg.sender?.display_name?.[0]?.toUpperCase() ?? '?'}
                                                              </div>
                                )}

                                      <div className={`max-w-[70%] flex flex-col ${isMine ? 'items-end' : 'items-start'}`}>
                                              {/* Sender name (other party) */}
                                                      {!isMine && <p className="text-xs text-gray-500 mb-1 ml-1">{msg.sender?.display_name ?? 'Anonyme'}</p>}

                                                              {/* Bubble */}
                                                                      <div className={`rounded-2xl px-4 py-2.5 text-sm ${isMine ? 'bg-yellow-400 text-black rounded-tr-sm' : 'bg-white/10 text-white rounded-tl-sm'}`}>
                                                                                {msg.attachment_url ? (
                                                                                                <a href={msg.attachment_url} target="_blank" rel="noreferrer"
                                                                                                              className="block text-blue-400 underline text-xs">
                                                                                                                            📷 Voir la preuve de paiement
                                                                                                                                        </a>
                                                                                ) : null}
                                                                                          {msg.message}
                                                                                                  </div>

                                                                                                          {/* Timestamp */}
                                                                                                                  <p className="text-xs text-gray-600 mt-1 mx-1">{time}</p>
                                                                                                                        </div>
                                                                                                                            </div>
            );
};
                                                                                )}
                                )}
            )
                )
          }
}
                                                                                          )}
                      )
                    }
                  }
                }
}